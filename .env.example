# Application Environment & Port Configuration
NODE_ENV=development
PORT=8000

# MongoDB Database Connection String (Replace with your MongoDB Atlas URI or local connection string)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/JobPosting?retryWrites=true&w=majority

# Authentication JWT Tokens
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_32bytes_minimum
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_32bytes_minimum
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary Storage Credentials (Required for image & document uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis Infrastructure Configuration
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=bc_api
REDIS_CONNECT_TIMEOUT_MS=5000

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=example@gmail.com
SMTP_PASS=password
EMAIL_FROM="JobPosting Platform <noreply@jobposting.com>"
